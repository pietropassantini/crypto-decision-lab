*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==================================================
# DATASETS
# ==================================================

# Raw market data
data/raw/
data/downloads/
data/cache/
data/quarantine/

# Frozen snapshots
data/snapshots/

# Generated datasets
data/datasets/
data/processed/
data/features/

