logs/
*.log
*.tmp
*.temp
*.pid

# ==================================================
# LOCAL CONFIGURATION
# ==================================================

config/local.yaml
config/dashboard.yaml
config/local.yml
config/local.json
config/secrets.*

# ==================================================
# KEEP DIRECTORY STRUCTURE
# ==================================================

!data/**/.gitkeep
!models/**/.gitkeep
!outputs/**/.gitkeep

# ==================================================
# S02-CP08-05 · FORWARD ARCHIVE (evidence, tracked)
# ==================================================

# The forward dataset is independent evidence: it must be preserved, so the
# global *.parquet rule is explicitly overridden for this archive only.
!data/forward/
!data/forward/**
!data/forward/**/*.parquet
!data/forward/**/*.json
!data/forward/**/*.md

# Operational files that are not evidence
data/forward/*/registry/sync.lock
var/log/

# ==================================================
# S02-CP08-05R · FROZEN PROTOCOL ARCHIVE (evidence, tracked)
# ==================================================

# The CP08-04 protocol archive is frozen evidence: its manifest pins every
# file by SHA-256. The generic "experiments/" rule above hid it from clones
# (Sirio reported ARCHIVE_MISSING), so exactly this archive is re-included.
# Nothing else under data/experiments is un-ignored here.
!data/experiments/
data/experiments/*
!data/experiments/S02-CP08-independent-validation-protocol-v1/
!data/experiments/S02-CP08-independent-validation-protocol-v1/**
