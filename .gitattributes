# Byte-stability across platforms: protocol/data hashes are pinned and verified
# at runtime, so Git must never rewrite line endings on these artefacts.
config/protocols/*.yaml text eol=lf
config/protocols/*.sha256 text eol=lf
data/**/*.json text eol=lf
data/**/*.jsonl text eol=lf
data/**/*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.parquet binary
.gitattributes text eol=lf

# S02-CP08-05R: the frozen CP08-04 archive is pinned byte-for-byte by SHA-256
# in its own manifest (JSON files were written with CRLF endings, the YAML
# copies preserve the original CRLF freeze). Git must never rewrite line
# endings inside it, otherwise every pinned hash breaks on every clone.
# This rule is LAST on purpose: in .gitattributes the last matching rule wins.
data/experiments/S02-CP08-independent-validation-protocol-v1/** -text -eol
